# Copy to .env (repository root). The Django settings load this file automatically.

# --- Django ------------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- External services (all free, no API keys required) ----------------------
# Any OSRM-compatible server. Alternatives: https://routing.openstreetmap.de/routed-car
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
# Multiply car-profile drive times to approximate truck speeds (1.0 = use API values).
TRUCK_DURATION_FACTOR=1.0

PHOTON_URL=https://photon.komoot.io/api/
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
HTTP_USER_AGENT=weather-aware-truck-routing/1.0

# --- Limits / tuning ---------------------------------------------------------
MAX_TRIP_MILES=2500
MAX_DEPARTURE_DAYS_AHEAD=10
HEATMAP_MAX_POINTS=180
HEATMAP_CORRIDOR_MILES=40
WEATHER_BATCH_SIZE=60
API_THROTTLE_RATE=120/min

# --- Frontend (Vite, build-time) ---------------------------------------------
# Only needed when the UI is hosted separately from the API.
# VITE_API_BASE=https://your-api.example.com/api
# Basemap: "esri-gray" (default, light canvas that keeps the heatmap readable) or "osm".
# VITE_BASEMAP=esri-gray
# Or any other XYZ provider:
# VITE_TILE_URL=https://{s}.tile.example.com/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; Example
